<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">openfilter_landing_form.openfilter_landing_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Landing page</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Iranimij\OpenFilter\Block\Adminhtml\Landing\Edit\BackButton"/>
            <button name="delete" class="Iranimij\OpenFilter\Block\Adminhtml\Landing\Edit\DeleteButton"/>
            <button name="save_and_continue" class="Iranimij\OpenFilter\Block\Adminhtml\Landing\Edit\SaveAndContinueButton"/>
            <button name="save" class="Iranimij\OpenFilter\Block\Adminhtml\Filter\Edit\SaveButton"/>
        </buttons>
        <namespace>openfilter_landing_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>openfilter_landing_form.openfilter_landing_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="openfilter_landing_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="openfilter/landing/save"/>
        </settings>
        <aclResource>Iranimij_OpenFilter::landing_pages</aclResource>
        <dataProvider class="Iranimij\OpenFilter\Ui\DataProvider\LandingForm" name="openfilter_landing_form_data_source">
            <settings>
                <requestFieldName>page_id</requestFieldName>
                <primaryFieldName>page_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">Page</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="page_id" formElement="input" sortOrder="1">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="is_active" formElement="checkbox" sortOrder="10">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="title" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="url_key" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL key</label>
                <notice translate="true">The page's address after the store's base URL, for example black-tops or women/black-tops.html. It must not be taken by a category, product or CMS page.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="store_ids" formElement="multiselect" sortOrder="40">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Store views</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Magento\Cms\Ui\Component\Listing\Column\Cms\Options"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="page_url" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Filtered category page</label>
                <notice translate="true">Open the category on the storefront, pick the filters, then paste the address here. The landing page shows that category with those filters.</notice>
                <placeholder>https://example.com/women/tops-women.html?color=black</placeholder>
            </settings>
        </field>
    </fieldset>
    <fieldset name="content" sortOrder="20">
        <settings>
            <label translate="true">Content</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="h1" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Heading (H1)</label>
                <notice translate="true">Empty = the title.</notice>
            </settings>
        </field>
        <field name="description" formElement="textarea" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Text above the products</label>
                <notice translate="true">HTML. Widgets and variables work as in CMS blocks.</notice>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>8</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="seo" sortOrder="30">
        <settings>
            <label translate="true">Search engines</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="meta_title" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta title</label>
                <notice translate="true">Empty = the title.</notice>
            </settings>
        </field>
        <field name="meta_description" formElement="textarea" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta description</label>
            </settings>
        </field>
        <field name="robots" formElement="select" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Robots</label>
                <notice translate="true">Indexed landing pages are listed in the XML sitemap and are the canonical address of their filter state.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenFilter\Model\Config\Source\Robots"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>

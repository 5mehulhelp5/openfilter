<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">openfilter_filter_form.openfilter_filter_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Filter</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Iranimij\OpenFilter\Block\Adminhtml\Filter\Edit\BackButton"/>
            <button name="reset" class="Iranimij\OpenFilter\Block\Adminhtml\Filter\Edit\ResetButton"/>
            <button name="save" class="Iranimij\OpenFilter\Block\Adminhtml\Filter\Edit\SaveButton"/>
        </buttons>
        <namespace>openfilter_filter_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>openfilter_filter_form.openfilter_filter_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="openfilter_filter_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="openfilter/filter/save"/>
        </settings>
        <aclResource>Iranimij_OpenFilter::filters</aclResource>
        <dataProvider class="Iranimij\OpenFilter\Ui\DataProvider\FilterForm" name="openfilter_filter_form_data_source">
            <settings>
                <requestFieldName>code</requestFieldName>
                <primaryFieldName>key</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="looks" sortOrder="10">
        <settings>
            <label translate="true">How it looks</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="key" formElement="input" sortOrder="1">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="store" formElement="input" sortOrder="2">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="display_mode" formElement="select" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Looks like</label>
                <notice translate="true">Only the types that fit this attribute are listed. Swatches need an attribute with swatches; sliders need a number attribute.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="ranges" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Ranges</label>
                <notice translate="true">For the "Ranges" type, for example 0-50,50-100,100- (the last range open). Empty = ranges made from the price step and the prices found.</notice>
                <placeholder translate="true">Automatic</placeholder>
            </settings>
        </field>
        <field name="tree_depth" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Category tree levels</label>
                <notice translate="true">For the "Category tree" type: how many levels below the current category are shown (1 to 5).</notice>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="validate-digits-range" xsi:type="string">1-5</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="behaves" sortOrder="20">
        <settings>
            <label translate="true">How it behaves</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="active" formElement="checkbox" sortOrder="10">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Show on the storefront</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="multiselect" formElement="checkbox" sortOrder="20">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Shoppers can pick several values</label>
                <notice translate="true">How several picked values combine is set in "Products must match".</notice>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="logic" formElement="select" sortOrder="25">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Products must match</label>
                <notice translate="true">"All" fits features a product can have several of (for example "Waterproof" and "Breathable"). Counts then show how many products have the value as well.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenFilter\Model\Config\Source\Logic"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="visible_options" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Options before "Show more"</label>
                <notice translate="true">0 = show all options.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="search_threshold" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Search box from this many options</label>
                <notice translate="true">Long lists get a search box at the top. 0 = never.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="expanded" formElement="select" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Open when the page loads</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenFilter\Model\Config\Source\Expanded"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="sort_by" formElement="select" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Option order</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenFilter\Model\Config\Source\SortBy"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="hide_single_option" formElement="checkbox" sortOrder="70">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Hide when only one option is left</label>
                <notice translate="true">A picked option always stays visible, so shoppers can remove it.</notice>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="position_override" formElement="input" sortOrder="80">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Position</label>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="where" sortOrder="25">
        <settings>
            <label translate="true">Where it shows</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="category_mode" formElement="select" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Show this filter</label>
                <notice translate="true">On category pages; a category counts with the categories below it. Search result pages always show the filter.</notice>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>all</value>
                            <actions>
                                <action name="0">
                                    <target>openfilter_filter_form.openfilter_filter_form.where.category_ids</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>only</value>
                            <actions>
                                <action name="0">
                                    <target>openfilter_filter_form.openfilter_filter_form.where.category_ids</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="2">
                            <value>except</value>
                            <actions>
                                <action name="0">
                                    <target>openfilter_filter_form.openfilter_filter_form.where.category_ids</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenFilter\Model\Config\Source\CategoryMode"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="category_ids" component="Magento_Catalog/js/components/new-category" formElement="select" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="chipsEnabled" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">true</item>
                    <item name="levelsVisibility" xsi:type="string">1</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Categories</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Catalog\Ui\Component\Product\Form\Categories\Options"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="seo" sortOrder="30">
        <settings>
            <label translate="true">SEO</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="seo_indexable" formElement="checkbox" sortOrder="10">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Let Google index pages filtered by this</label>
                <notice translate="true">Only pages with exactly one value of this filter are indexed (for example "Red" t-shirts). Pages with more values always ask search engines not to index them.</notice>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="url_name" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL name</label>
                <notice translate="true">The name of this filter in URLs, for example ?color=red. Changing it changes published URLs.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <dynamicRows name="option_urls" sortOrder="30">
            <settings>
                <label translate="true">URL names of the options</label>
                <addButton>false</addButton>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">false</param>
                </dndConfig>
                <componentType>dynamicRows</componentType>
                <additionalClasses>
                    <class name="admin__field-wide">true</class>
                </additionalClasses>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="option_id" formElement="input" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="option_label" formElement="input" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Option</label>
                        <elementTmpl>Iranimij_OpenFilter/form/element/row-text</elementTmpl>
                        <disabled>true</disabled>
                    </settings>
                </field>
                <field name="url_name_0" formElement="input" sortOrder="30">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">URL name (all store views)</label>
                        <elementTmpl>Iranimij_OpenFilter/form/element/row-input</elementTmpl>
                    </settings>
                </field>
                <field name="regenerate" formElement="checkbox" sortOrder="900">
                    <settings>
                        <dataType>boolean</dataType>
                        <label translate="true">Generate again from the label</label>
                        <elementTmpl>Iranimij_OpenFilter/form/element/row-checkbox</elementTmpl>
                    </settings>
                    <formElements>
                        <checkbox>
                            <settings>
                                <valueMap>
                                    <map name="false" xsi:type="string">0</map>
                                    <map name="true" xsi:type="string">1</map>
                                </valueMap>
                            </settings>
                        </checkbox>
                    </formElements>
                </field>
            </container>
        </dynamicRows>
    </fieldset>
    <fieldset name="why" sortOrder="90">
        <settings>
            <label translate="true">Why is this filter not showing?</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <htmlContent name="why_panel">
            <block class="Iranimij\OpenFilter\Block\Adminhtml\Filter\WhyPanel" name="openfilter.filter.why" template="Iranimij_OpenFilter::filter/why.phtml"/>
        </htmlContent>
    </fieldset>
    <fieldset name="labels" sortOrder="40">
        <settings>
            <label translate="true">Labels per store view</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="label_0" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Label for all store views</label>
                <notice translate="true">Empty = the attribute's own label.</notice>
            </settings>
        </field>
        <field name="tooltip_0" formElement="textarea" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Tooltip for all store views</label>
                <notice translate="true">A short hint shoppers open next to the filter name (plain text). Empty = no tooltip.</notice>
            </settings>
        </field>
    </fieldset>
</form>

            <block class="Iranimij\OpenFilter\Block\Adminhtml\Config\TemplatePreview" name="openfilter.config.template.length"
                   template="Iranimij_OpenFilter::config/template-length.phtml"/>
        </referenceContainer>
    </body>
</page>

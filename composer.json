{
    "name": "iranimij/openfilter",
    "description": "OpenFilter: layered navigation for Magento 2 and Hyvä. Multi-select filters with correct counts, AJAX that is cache- and CSP-correct, price slider, SEO-safe URLs. Built on the OpenSearch Magento ships. Free and MIT.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "mage-os",
        "hyva",
        "layered-navigation",
        "ajax-filters",
        "faceted-search",
        "opensearch",
        "openfilter"
    ],
    "homepage": "https://github.com/iranimij/openfilter",
    "support": {
        "issues": "https://github.com/iranimij/openfilter/issues",
        "source": "https://github.com/iranimij/openfilter",
        "docs": "https://github.com/iranimij/openfilter/tree/main/docs"
    },
    "authors": [
        {
            "name": "Iman Aboheydary",
            "homepage": "https://github.com/iranimij"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "iranimij/module-base": "^1.0",
        "magento/framework": "^103.0.7",
        "magento/module-advanced-search": "^100.4.5",
        "magento/module-backend": "^102.0.7",
        "magento/module-catalog": "^104.0.7",
        "magento/module-catalog-inventory": "^100.4.7",
        "magento/module-catalog-search": "^102.0.7",
        "magento/module-config": "^101.2.7",
        "magento/module-customer": "^103.0.7",
        "magento/module-eav": "^102.1.7",
        "magento/module-elasticsearch": "^101.0.7",
        "magento/module-review": "^100.4.7",
        "magento/module-search": "^101.1.7",
        "magento/module-sitemap": "^100.4",
        "magento/module-store": "^101.1.7",
        "magento/module-swatches": "^100.4.7",
        "magento/module-tax": "^100.4.7",
        "magento/module-theme": "^101.1.7",
        "magento/module-ui": "^101.2.7",
        "magento/module-url-rewrite": "^102.0"
    },
    "suggest": {
        "iranimij/openfilter-hyva": "Storefront rendering for Hyvä themes (AJAX, mobile drawer, sliders)"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Iranimij\\OpenFilter\\": ""
        }
    },
    "extra": {
        "iranimij": {
            "changelog": "https://github.com/iranimij/openfilter/blob/main/CHANGELOG.md"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="controller_action_predispatch_catalog_category_view">
        <observer name="openfilter_normalize_filter_params" instance="Iranimij\OpenFilter\Observer\NormalizeFilterParams"/>
    </event>
    <event name="controller_action_predispatch_catalogsearch_result_index">
        <observer name="openfilter_normalize_filter_params" instance="Iranimij\OpenFilter\Observer\NormalizeFilterParams"/>
    </event>
    <event name="controller_action_predispatch_openfilter_all_index">
        <observer name="openfilter_normalize_filter_params" instance="Iranimij\OpenFilter\Observer\NormalizeFilterParams"/>
    </event>
    <event name="layout_generate_blocks_after">
        <observer name="openfilter_all_products_heading" instance="Iranimij\OpenFilter\Observer\AllProductsHeading"/>
        <observer name="openfilter_seo_head" instance="Iranimij\OpenFilter\Observer\ApplySeoHead"/>
        <observer name="openfilter_landing_head" instance="Iranimij\OpenFilter\Observer\LandingHead"/>
    </event>
</config>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- 1.2: path filter URLs before Magento's URL rewrite router (20) takes the category path; the All Products page's URL
         key and landing pages (1.2) after it, before the standard router (30). -->
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="openfilter_path_filters" xsi:type="array">
                    <item name="class" xsi:type="string">Iranimij\OpenFilter\Controller\PathRouter</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">15</item>
                </item>
                <item name="openfilter_landing_pages" xsi:type="array">
                    <item name="class" xsi:type="string">Iranimij\OpenFilter\Controller\LandingRouter</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">24</item>
                </item>
                <item name="openfilter_all_products" xsi:type="array">
                    <item name="class" xsi:type="string">Iranimij\OpenFilter\Controller\Router</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">25</item>
                </item>
                <item name="openfilter_old_urls" xsi:type="array">
                    <item name="class" xsi:type="string">Iranimij\OpenFilter\Controller\MigrationRouter</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">26</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- The insight beacon (1.2) is not a visit: Magento's visitor log skips the openfilter route (its POSTs). -->
    <type name="Magento\Customer\Model\Visitor">
        <arguments>
            <argument name="ignores" xsi:type="array">
                <item name="openfilter" xsi:type="boolean">true</item>
            </argument>
        </arguments>
    </type>
</config>

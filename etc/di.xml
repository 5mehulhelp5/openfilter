<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Iranimij\OpenFilter\Api\FacetCountStrategyInterface"
                type="Iranimij\OpenFilter\Model\Search\Strategy\SingleQuery"/>

    <preference for="Iranimij\OpenFilter\Api\FilterConfigRepositoryInterface"
                type="Iranimij\OpenFilter\Model\Config\FilterConfigRepository"/>

    <preference for="Iranimij\OpenFilter\Api\SlugRepositoryInterface"
                type="Iranimij\OpenFilter\Model\Url\SlugRepository"/>

    <type name="Iranimij\OpenFilter\Model\Search\QueryState" shared="true"/>

    <type name="Iranimij\OpenFilter\Model\Config\FilterConfigProvider">
        <arguments>
            <argument name="cache" xsi:type="object">Iranimij\OpenFilter\Model\Cache\Type</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenFilter\Model\Url\SlugProvider">
        <arguments>
            <argument name="cache" xsi:type="object">Iranimij\OpenFilter\Model\Cache\Type</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenFilter\Model\Url\SlugRepository">
        <arguments>
            <argument name="cache" xsi:type="object">Iranimij\OpenFilter\Model\Cache\Type</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenFilter\Model\Config\FilterConfigRepository">
        <arguments>
            <argument name="cache" xsi:type="object">Iranimij\OpenFilter\Model\Cache\Type</argument>
        </arguments>
    </type>

    <type name="Iranimij\OpenFilter\Model\Search\StrategyResolver">
        <arguments>
            <argument name="strategies" xsi:type="array">
                <item name="single_query" xsi:type="object">Iranimij\OpenFilter\Model\Search\Strategy\SingleQuery</item>
                <item name="per_attribute" xsi:type="object">Iranimij\OpenFilter\Model\Search\Strategy\PerAttribute</item>
            </argument>
            <!-- "auto": decided per engine by the M0 spike (docs/facet-counts.md). -->
            <argument name="autoByEngine" xsi:type="array">
                <item name="opensearch" xsi:type="string">single_query</item>
                <item name="elasticsearch8" xsi:type="string">single_query</item>
                <item name="elasticsearch7" xsi:type="string">single_query</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Elasticsearch\ElasticAdapter\SearchAdapter\Mapper">
        <plugin name="openfilter_facet_counts" type="Iranimij\OpenFilter\Plugin\Search\MapperPlugin"/>
    </type>
    <type name="Magento\Elasticsearch\SearchAdapter\Aggregation\Builder">
        <plugin name="openfilter_facet_counts" type="Iranimij\OpenFilter\Plugin\Search\AggregationBuilderPlugin"/>
    </type>
</config>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="openfilter_attribute" resource="default" engine="innodb" comment="OpenFilter settings per filterable attribute">
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" comment="Attribute ID"/>
        <column xsi:type="varchar" name="display_mode" length="16" nullable="false" default="list" comment="Display mode"/>
        <column xsi:type="smallint" name="multiselect" unsigned="true" nullable="false" default="1" comment="Several values (OR)"/>
        <column xsi:type="varchar" name="logic" length="8" nullable="false" default="or" comment="Logic within the attribute"/>
        <column xsi:type="smallint" name="visible_options" unsigned="true" nullable="false" default="6" comment="Options before Show more (0 = all)"/>
        <column xsi:type="smallint" name="search_threshold" unsigned="true" nullable="false" default="12" comment="Search box above this many options (0 = never)"/>
        <column xsi:type="smallint" name="expanded" unsigned="true" nullable="true" comment="Null = automatic, 1 open, 0 closed"/>
        <column xsi:type="varchar" name="sort_by" length="16" nullable="false" default="position" comment="Option order"/>
        <column xsi:type="smallint" name="hide_single_option" unsigned="true" nullable="false" default="1" comment="Hide a filter with one option"/>
        <column xsi:type="smallint" name="seo_indexable" unsigned="true" nullable="false" default="0" comment="Single-value pages indexable"/>
        <column xsi:type="int" name="position_override" nullable="true" comment="Null = attribute position"/>
        <column xsi:type="varchar" name="ranges" length="255" nullable="true" comment="Price ranges list (1.1): from-to,... in the URL format; null = automatic"/>
        <column xsi:type="smallint" name="tree_depth" unsigned="true" nullable="false" default="3" comment="Category tree levels (1.1)"/>
        <column xsi:type="varchar" name="depends_on" length="80" nullable="true" comment="Shown only after a pick in this filter (1.2)"/>
        <column xsi:type="varchar" name="depends_values" length="255" nullable="true" comment="Values of depends_on that show it, comma-separated; null = any (1.2)"/>
        <column xsi:type="smallint" name="quick_bar" unsigned="true" nullable="false" default="0" comment="Options in the quick filter bar (1.2)"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Shown on the storefront"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="attribute_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_ATTR_ATTR_ID_EAV_ATTR_ATTR_ID" table="openfilter_attribute"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id" onDelete="CASCADE"/>
    </table>
    <table name="openfilter_attribute_store" resource="default" engine="innodb" comment="OpenFilter labels per store view">
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" comment="Attribute ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="varchar" name="label_override" length="255" nullable="true" comment="Label override"/>
        <column xsi:type="text" name="tooltip" nullable="true" comment="Tooltip (1.1)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="attribute_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_ATTR_STORE_ATTR_ID_EAV_ATTR_ATTR_ID" table="openfilter_attribute_store"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_ATTRIBUTE_STORE_STORE_ID_STORE_STORE_ID" table="openfilter_attribute_store"
                    column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
    <table name="openfilter_builtin" resource="default" engine="innodb" comment="OpenFilter built-in filters">
        <column xsi:type="varchar" name="code" length="16" nullable="false" comment="rating, stock, sale, new, price, category"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="0" comment="Shown on the storefront"/>
        <column xsi:type="varchar" name="display_mode" length="16" nullable="false" default="list" comment="Display mode"/>
        <column xsi:type="smallint" name="multiselect" unsigned="true" nullable="false" default="0" comment="Several values (OR)"/>
        <column xsi:type="varchar" name="logic" length="8" nullable="false" default="or" comment="Logic"/>
        <column xsi:type="smallint" name="visible_options" unsigned="true" nullable="false" default="6" comment="Options before Show more"/>
        <column xsi:type="smallint" name="search_threshold" unsigned="true" nullable="false" default="12" comment="Search box threshold"/>
        <column xsi:type="smallint" name="expanded" unsigned="true" nullable="true" comment="Null = automatic"/>
        <column xsi:type="varchar" name="sort_by" length="16" nullable="false" default="position" comment="Option order"/>
        <column xsi:type="smallint" name="hide_single_option" unsigned="true" nullable="false" default="1" comment="Hide with one option"/>
        <column xsi:type="smallint" name="seo_indexable" unsigned="true" nullable="false" default="0" comment="Single-value pages indexable"/>
        <column xsi:type="int" name="position_override" nullable="true" comment="Null = default position"/>
        <column xsi:type="varchar" name="ranges" length="255" nullable="true" comment="Price ranges list (1.1): from-to,... in the URL format; null = automatic"/>
        <column xsi:type="smallint" name="tree_depth" unsigned="true" nullable="false" default="3" comment="Category tree levels (1.1)"/>
        <column xsi:type="varchar" name="depends_on" length="80" nullable="true" comment="Shown only after a pick in this filter (1.2)"/>
        <column xsi:type="varchar" name="depends_values" length="255" nullable="true" comment="Values of depends_on that show it, comma-separated; null = any (1.2)"/>
        <column xsi:type="smallint" name="quick_bar" unsigned="true" nullable="false" default="0" comment="Options in the quick filter bar (1.2)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="code"/>
        </constraint>
    </table>
    <table name="openfilter_builtin_store" resource="default" engine="innodb" comment="OpenFilter built-in filter labels per store view">
        <column xsi:type="varchar" name="code" length="16" nullable="false" comment="Built-in code"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="varchar" name="label" length="255" nullable="true" comment="Label"/>
        <column xsi:type="text" name="tooltip" nullable="true" comment="Tooltip (1.1)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="code"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_BUILTIN_STORE_CODE_OPENFILTER_BUILTIN_CODE" table="openfilter_builtin_store"
                    column="code" referenceTable="openfilter_builtin" referenceColumn="code" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_BUILTIN_STORE_STORE_ID_STORE_STORE_ID" table="openfilter_builtin_store"
                    column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
    <table name="openfilter_option_slug" resource="default" engine="innodb" comment="OpenFilter option URL names">
        <column xsi:type="int" name="option_id" unsigned="true" nullable="false" comment="Option ID"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" comment="Attribute ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID (0 = all)"/>
        <column xsi:type="varchar" name="slug" length="128" nullable="false" comment="URL name"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="option_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="OPENFILTER_OPTION_SLUG_ATTRIBUTE_ID_STORE_ID_SLUG">
            <column name="attribute_id"/>
            <column name="store_id"/>
            <column name="slug"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_OPT_SLUG_OPT_ID_EAV_ATTR_OPT_OPT_ID" table="openfilter_option_slug"
                    column="option_id" referenceTable="eav_attribute_option" referenceColumn="option_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_OPT_SLUG_ATTR_ID_EAV_ATTR_ATTR_ID" table="openfilter_option_slug"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_OPTION_SLUG_STORE_ID_STORE_STORE_ID" table="openfilter_option_slug"
                    column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
    <table name="openfilter_attribute_slug" resource="default" engine="innodb" comment="OpenFilter URL parameter names">
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" comment="Attribute ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID (0 = all)"/>
        <column xsi:type="varchar" name="slug" length="64" nullable="false" comment="URL parameter name"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="attribute_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="OPENFILTER_ATTRIBUTE_SLUG_STORE_ID_SLUG">
            <column name="store_id"/>
            <column name="slug"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_ATTR_SLUG_ATTR_ID_EAV_ATTR_ATTR_ID" table="openfilter_attribute_slug"
                    column="attribute_id" referenceTable="eav_attribute" referenceColumn="attribute_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_ATTRIBUTE_SLUG_STORE_ID_STORE_STORE_ID" table="openfilter_attribute_slug"
                    column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
    <table name="openfilter_filter_category" resource="default" engine="innodb" comment="OpenFilter: where a filter shows (1.1)">
        <column xsi:type="varchar" name="filter_key" length="80" nullable="false" comment="Filter key (code, or attribute:code)"/>
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" comment="Category ID"/>
        <column xsi:type="varchar" name="mode" length="8" nullable="false" default="hide" comment="show = only these categories, hide = all but these"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="filter_key"/>
            <column name="category_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_FILTER_CTGR_CTGR_ID_CAT_CTGR_ENTT_ENTT_ID" table="openfilter_filter_category"
                    column="category_id" referenceTable="catalog_category_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="OPENFILTER_FILTER_CATEGORY_CATEGORY_ID" indexType="btree">
            <column name="category_id"/>
        </index>
    </table>
    <table name="openfilter_option_image" resource="default" engine="innodb" comment="OpenFilter: option images (1.2)">
        <column xsi:type="int" name="option_id" unsigned="true" nullable="false" comment="Option ID"/>
        <column xsi:type="varchar" name="image" length="255" nullable="false" comment="Path below media/openfilter/options"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="option_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_OPT_IMAGE_OPT_ID_EAV_ATTR_OPT_OPT_ID" table="openfilter_option_image"
                    column="option_id" referenceTable="eav_attribute_option" referenceColumn="option_id" onDelete="CASCADE"/>
    </table>
    <table name="openfilter_landing_page" resource="default" engine="innodb" comment="OpenFilter: landing pages (1.2)">
        <column xsi:type="int" name="page_id" unsigned="true" nullable="false" identity="true" comment="Page ID"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Shown on the storefront"/>
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" comment="Category the page filters"/>
        <column xsi:type="text" name="filters" nullable="false" comment="Filter state: JSON of filter key => values (option ids, from-to)"/>
        <column xsi:type="varchar" name="url_key" length="255" nullable="false" comment="URL key below the store's address"/>
        <column xsi:type="varchar" name="title" length="255" nullable="false" comment="Page title and default heading"/>
        <column xsi:type="varchar" name="h1" length="255" nullable="true" comment="Heading; empty = the title"/>
        <column xsi:type="varchar" name="meta_title" length="255" nullable="true" comment="Meta title; empty = the title"/>
        <column xsi:type="text" name="meta_description" nullable="true" comment="Meta description"/>
        <column xsi:type="mediumtext" name="description" nullable="true" comment="Content above the products"/>
        <column xsi:type="varchar" name="robots" length="32" nullable="false" default="INDEX,FOLLOW" comment="Robots"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="page_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_LANDING_PAGE_CTGR_ID_CAT_CTGR_ENTT_ENTT_ID" table="openfilter_landing_page"
                    column="category_id" referenceTable="catalog_category_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
    <table name="openfilter_landing_page_store" resource="default" engine="innodb" comment="OpenFilter: store views of landing pages (1.2)">
        <column xsi:type="int" name="page_id" unsigned="true" nullable="false" comment="Page ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID (0 = all)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="page_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_LANDING_PAGE_STORE_PAGE_ID_LANDING_PAGE_PAGE_ID" table="openfilter_landing_page_store"
                    column="page_id" referenceTable="openfilter_landing_page" referenceColumn="page_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_LANDING_PAGE_STORE_STORE_ID_STORE_STORE_ID" table="openfilter_landing_page_store"
                    column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
    <table name="openfilter_insight_daily" resource="default" engine="innodb" comment="OpenFilter: daily filter use counts, nothing about shoppers (1.2)">
        <column xsi:type="date" name="day" nullable="false" comment="Day"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" default="0" comment="Category ID (0 = search results)"/>
        <column xsi:type="varchar" name="kind" length="8" nullable="false" comment="view, filter, value or zero"/>
        <column xsi:type="varchar" name="filter_key" length="80" nullable="false" default="" comment="Filter key"/>
        <column xsi:type="varchar" name="value" length="255" nullable="false" default="" comment="Value, or the filters of a zero-result page"/>
        <column xsi:type="int" name="hits" unsigned="true" nullable="false" default="0" comment="Count"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="day"/>
            <column name="store_id"/>
            <column name="category_id"/>
            <column name="kind"/>
            <column name="filter_key"/>
            <column name="value"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OPENFILTER_INSIGHT_DAILY_STORE_ID_STORE_STORE_ID" table="openfilter_insight_daily"
                    column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="OPENFILTER_INSIGHT_DAILY_KIND_DAY" indexType="btree">
            <column name="kind"/>
            <column name="day"/>
        </index>
    </table>
</schema>
